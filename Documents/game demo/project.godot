; Engine configuration for Godot 4.x
; https://docs.godotengine.org/en/stable/tutorials/project_organization/project_basics.html

config_version=5

[application]
config/name="Rhythm Fishing"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]
GameManager="*res://src/game_manager.gd"
InputManager="*res://src/input_manager.gd"
AudioManager="*res://src/audio_manager.gd"
SceneManager="*res://src/scene_manager.gd"

[debug]
gdscript/warnings/unused_variable=1
gdscript/warnings/unused_argument=1

[physics]
2d/default_gravity=980

[rendering]
textures/canvas_textures/default_texture_filter=0
